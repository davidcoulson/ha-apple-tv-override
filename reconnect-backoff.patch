 BACKOFF_TIME_LOWER_LIMIT = 15  # seconds
 BACKOFF_TIME_UPPER_LIMIT = 300  # Five minutes
 
+# OVERRIDE (davidcoulson/ha-apple-tv-override): a connection that is lost this
+# soon after it was made counts as short-lived. An Apple TV in standby accepts
+# a connection, announces about 15 s later that it is going to sleep, and stops
+# answering; reconnecting at once wakes it again, about once a minute for as
+# long as it sleeps. Each short-lived connection in a row doubles the wait
+# before the next attempt, up to BACKOFF_TIME_UPPER_LIMIT.
+SHORT_LIVED_CONNECTION = 120  # seconds
+
+
+def reconnect_delay(short_lived_connections: int) -> int:
+    """Seconds to wait before reconnecting after short-lived connections in a row."""
+    if short_lived_connections <= 0:
+        return 0
+    return min(
+        BACKOFF_TIME_LOWER_LIMIT * 2**short_lived_connections,
+        BACKOFF_TIME_UPPER_LIMIT,
+    )
+
